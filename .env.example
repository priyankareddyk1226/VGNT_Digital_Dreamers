# Application Environment
ENVIRONMENT=development
DEMO_MODE=true

# Database (SQLite path)
DATABASE_URL=sqlite:////app/data/land_intelligence.db

# JWT Configuration
SECRET_KEY=generate_a_secure_random_key_here_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI/ML Feature Flags (Allows running in constrained environments)
ENABLE_PADDLE_OCR=false
ENABLE_SENTENCE_TRANSFORMERS=false
ENABLE_LOCAL_LLM=false

# Ports
PORT=7860
